@article{daSilvaJnior2024spacerace,
   abstract = {This work provides information about the design, implementation, and assessment of the instructional role of a bilingual (English and Portuguese) web-based board game designed to assist Brazilian Mechanical Engineering undergraduate students in reviewing the content related to thermodynamics, chemical equilibrium, and chemical kinetics. The game can be an alternative instrument to traditional problem-solving classes. Sixty-four mechanical engineering undergraduate students played the game using the Portuguese version and evaluated it positively. Also, learning assessments revealed that the game effectively promotes learning like conventional problem-solving classes.},
   author = {José Nunes da Silva Júnior and Maria Elenir Nobre Pinho Ribeiro and Antonio José Melo Leite Junior and Maria Clara de Oliveira Alexandre and Francisco Serra Oliveira Alexandre and André Jalles Monteiro},
   doi = {10.1021/acs.jchemed.3c00981},
   issn = {19381328},
   issue = {5},
   journal = {Journal of Chemical Education},
   keywords = {Chemical Equilibrium,Chemical Kinetics,Computer-Based Learning,First-Year Undergraduate/General,Humor/Puzzles/Games,Physical Chemistry,Thermodynamics},
   month = {4},
   pages = {1875-1882},
   publisher = {American Chemical Society},
   title = {Space Race Game: A Web-Based Board Game for Aiding Students in Reviewing Thermochemistry, Chemical Equilibrium, and Chemical Kinetics},
   volume = {101},
   year = {2024}
}
@article{Pinthong2024,
   abstract = {The coronavirus (COVID-19) pandemic prevented students from attending on-site classes. Consequently, their face-to-face interactions decreased. Thus, it became crucial to design learning activities to enhance the motivation of students and inspire them to achieve the desired learning outcomes during the long disruption of on-site classes. Mobile devices and applications represent the most frequently used alternatives to online learning tools. During the COVID-19 pandemic, biochemists faced the challenges of integrating technology and biochemistry principles to allow students to investigate difficult topics, such as factors affecting enzyme activity. We created the Metal Demon Conqueror Game to address this difficulty: this new digital game-based learning tool is intended to encourage undergraduate students to learn about factors affecting enzyme activity. This challenging game comprises five levels entailing enzyme concentrations, temperature, cofactors, pH, and the final stage. The content component of the game allows students to explore the fundamental concepts related to factors affecting enzyme activity and enables them to engage in self-paced learning by playing the game from anywhere, at any time. The evaluation questionnaire revealed that the Metal Demon Conqueror Game could promote the learning of the factors affecting enzyme activity and help students grasp the content better than learning from textbooks. Students were interested in using the game and were satisfied with their learning of the factors affecting enzyme activity. Thus, the game offers a more engaging experience than learning from textbooks and is an interactive learning experience for students.},
   author = {Chatchadaporn Pinthong and Natpawee Poungkaew and Titapa Ampaipis and Jirapipat Thanyaphongphat and Panu Pimviriyakul and Somchart Maenpuen},
   doi = {10.1021/acs.jchemed.3c01212},
   issn = {19381328},
   issue = {4},
   journal = {Journal of Chemical Education},
   keywords = {Biochemistry,Computer-Based Learning,Distance Learning/Self Instruction,Enzymes,First-Year Undergraduate/General,Internet/Web-Based Learning,Kinetics,Upper-Division Undergraduate},
   month = {4},
   pages = {1718-1725},
   publisher = {American Chemical Society},
   title = {Metal Demon Conqueror Game: A New Digital Game-Based Learning Tool on Factors Affecting Enzyme Activity},
   volume = {101},
   year = {2024}
}
